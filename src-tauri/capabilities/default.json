{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. Add only what a feature needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-accessibility-status",
    "allow-open-accessibility-settings",
    "allow-database-status",
    "allow-continue-opening",
    "allow-retry-opening",
    "allow-start-over",
    "allow-page-text",
    "allow-save-page",
    "allow-close-page",
    "allow-delete-old-page-files",
    "allow-keep-old-page-files",
    "allow-filevault-enabled",
    "allow-capture-status",
    "allow-recent-captures",
    "allow-search-captures",
    "allow-capture-detail",
    "allow-captured-apps",
    "allow-forget-captures",
    "allow-delete-all-data",
    "allow-retention-days",
    "allow-set-retention-days",
    "allow-exclusion-settings",
    "allow-add-exclusion",
    "allow-remove-exclusion",
    "allow-set-default-excluded",
    "allow-find-local-models",
    "allow-model-settings",
    "allow-set-model",
    "allow-clear-model",
    "allow-test-model",
    "allow-outbox-entries",
    "allow-outbox-payload",
    "allow-delete-outbox",
    "allow-outbox-retention-days",
    "allow-set-outbox-retention-days",
    "allow-journal-status",
    "allow-set-journal-enabled",
    "allow-journal-episodes",
    "allow-ask-memory",
    "allow-memory-status",
    "allow-set-memory-enabled",
    "allow-memory-entities",
    "allow-forget-entity",
    "allow-forget-memory",
    "allow-keep-entity",
    "allow-rename-entity",
    "allow-merge-entities",
    "allow-dont-learn-list",
    "allow-allow-learning",
    "allow-setup-status",
    "allow-finish-setup",
    "allow-writing-status",
    "allow-set-writing-enabled",
    "allow-set-writing-key",
    "allow-recreate-page",
    "allow-recreate-about-me",
    "allow-open-memory-folder",
    "allow-set-own-names",
    "allow-page-history",
    "allow-restore-page-version"
  ]
}
